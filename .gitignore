# Dependencies. Untracked and unignored is how a repo accidentally gains 40MB of node_modules.
node_modules/

# Move build output. Regenerated by `sui move build`; Move.lock is the file that pins revisions
# and IS committed.
sui-contracts/build/
sui-contracts-mind/build/

# Real configuration. `.env.example` is committed and carries the live mainnet ids; `.env` is
# where a deployment's own values go and must not be.
.env
.env.local

.DS_Store

# Next.js build output
packages/web/.next/
# Verification builds go here so they cannot overwrite what `next dev` is serving.
packages/web/.next-verify/
# And the dev server's own directory, for the same reason in the other direction: a `next
# build` into `.next` leaves a production route manifest there, and a later `next dev`
# reading it serves a stale set of routes — a page added after that build 404s while its
# file sits on disk. Measured: /agents returned 404 with app/agents/page.tsx present and
# compiling, because .next/build-manifest.json listed only the routes of the earlier build.
packages/web/.next-dev/
packages/web/next-env.d.ts

# TypeScript's incremental build cache. Generated, and it was tracked for 126 commits — every run
# of `tsc` produced a diff, which is noise, and one of those cached states hid a real defect: the
# note in app/api/creator/profile/route.ts records `tsc` passing against a cache written before
# `vaultId` could be null, so the type error only appeared once somebody built from clean.
# A cache that can disagree with the source is not something a checkout should carry.
packages/web/tsconfig.tsbuildinfo

# Compiled SDK output — regenerated by `pnpm --filter @projectx-social/sdk build`
packages/sdk/dist/
packages/mcp/dist/
packages/agent/dist/
packages/signer/dist/
packages/policy/dist/

# Test-address key material. Never committed.
# A throwaway address used to exercise the subscribe path end to end; it holds only the small
# amount needed for gas plus one subscription. It is not a protocol key and holds no capability.
.secrets/

# Content store — real posts, written at runtime. Seeded content is committed; a deployment's own
# store is not, so a checkout never carries someone else's posts.
packages/web/data/

# Local database dumps
*.dump

packages/web/AGENTS.md
packages/web/CLAUDE.md

# The browser test signer's keypairs. Generated at runtime into PROJECTX_TEST_WALLET_FILE, which
# must point OUTSIDE this tree — the first version of that script used fixed seeds, funded them on
# mainnet, and both addresses were swept within thirty seconds by a bot that held the keys.
*test-wallet*.json
.env
# Compiled daemon output. Regenerated by `pnpm --filter @projectx-social/daemon build`, and built
# inside the container image rather than copied into it.
packages/daemon/dist/
.vercel

# Database dumps. Real posts, real DMs, real signature digests — never committed.
/backups/
supabase/.temp/

analysis/IP-SCHEDULE-DATA.md

# Never published: local notes, scan output, content backups, private planning.
CLAUDE.md
**/CLAUDE.md
strix_runs/
backups/
analysis/
STATUS.md
PLAN.md

# Local editor/agent launch configs.
.claude/
.env*

# Signing key material, by every filename this repository actually gives it.
#
# The harvest signer is a bech32 `suiprivkey1...` — packages/daemon/.env.example documents it and
# packages/daemon/deploy/social-startup.sh fetches it from Secret Manager into a 0600 file. On a
# laptop it lands in a file instead, and until now nothing here refused it: `harvest.key` and
# `signer.json` were both committable. `.env` was ignored and these were not, which is the gap a
# key walks through.
#
# `*.key` and `*.pem` are the same two globs .gcloudignore already uses to keep key material out of
# the Cloud Build context; git should refuse what the build context refuses.
harvest.key
signer.json
*.key
*.pem

# The runtime secrets file. install-cos.sh and social-startup.sh write PROJECTX_DAEMON_SIGNER_SECRET
# and the journal URL to /run/projectx-social/secrets.env, which is tmpfs precisely so no disk holds
# a credential. A copy pulled back here for debugging keeps that name and must not be committed.
secrets.env
*.secrets.env

# The Sui CLI keystore. sui-contracts/deploy/mainnet.json records keys being added to and removed
# from this machine's keystore around the multisig transfer; the file itself holds them in the clear.
sui.keystore

# Multisig committee card. Public keys only — nothing secret — but it is operational
# custody documentation and belongs wherever the keys are kept, not in a repo any
# collaborator can clone.
MULTISIG-RECOVERY-CARD.md
**/MULTISIG-RECOVERY-CARD.md

# Python bytecode. `scripts/scan-secrets.py` is run by the git hooks, so CPython writes a
# `__pycache__` beside it on every push. A compiled copy of the secret scanner was committed in
# 185a9cc by a `git add -A scripts` that was meant to add two files, and this repository is on a
# publication path.
__pycache__/
*.pyc

{
  "name": "@projectx-social/daemon",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "weir-harvest": "./dist/main.js",
    "weir-harvest-status": "./dist/status-main.js",
    "weir-harvest-journal": "./dist/journal-main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:chain": "vitest run --config vitest.chain.config.ts",
    "start": "tsx src/main.ts",
    "dry-run": "tsx src/main.ts --once --dry-run",
    "status": "tsx src/status-main.ts",
    "journal": "tsx src/journal-main.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@mysten/sui": "2.27.1",
    "@projectx-social/policy": "workspace:*",
    "@projectx-social/sdk": "workspace:*",
    "@projectx-social/signer": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "type": "module"
}
